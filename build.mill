    }

    object guardedFpBridge extends SbtTests with TestModule.ScalaTest {
        // Real bounded arithmetic bridge; compile all production and HardFloat sources.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/GuardedFpBridgeGsim.scala",
            pwd / "src/test/scala/ooo/GuardedFpBridgeConfigSpec.scala",
