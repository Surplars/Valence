    object guardedGuestFpCore extends SbtTests with TestModule.ScalaTest {
        // Genuine translated core qualification; retain all production and HardFloat dependencies.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/GuardedGuestFpCoreGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpCoreConfigSpec.scala",
            pwd / "src/test/scala/ooo/FloatingPointStateGsim.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object guardedFpFaultRecovery extends SbtTests with TestModule.ScalaTest {
        // Real drained fault-consumer composition; retain all production/HardFloat dependencies.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/GuardedFpFaultRecoveryGsim.scala",
            pwd / "src/test/scala/ooo/GuardedFpFaultRecoveryConfigSpec.scala",
            pwd / "src/test/scala/ooo/FloatingPointStateGsim.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala"
        )
