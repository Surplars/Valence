//| mvnDeps: ["org.chipsalliance:firtool-resolver_2.13:2.0.1"]
//| mill-jvm-version: system

import mill.*, scalalib.*

// Note: This project requires .mill-jvm-opts file containing:
//   -Dchisel.project.root=${PWD}
// This is needed because Chisel needs to know the project root directory
// to properly generate and handle test directories and output files.
// See: https://github.com/com-lihaoyi/mill/issues/3840

val pwd                 = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
val defaultScalaVersion = "2.13.17"

object deps {
    val scala         = defaultScalaVersion
    val chiselVersion = "7.3.0"

    val chisel       = mvn"org.chipsalliance::chisel:$chiselVersion"
    val chiselPlugin = mvn"org.chipsalliance:::chisel-plugin:$chiselVersion"
    val scalatest    = mvn"org.scalatest::scalatest:3.2.19"
}

trait CommonModule extends ScalaModule {
    override def scalaVersion = deps.scala

    override def scalacOptions = Seq("-Ymacro-annotations")
}

trait HasChisel extends ScalaModule {
    override def mvnDeps             = Seq(deps.chisel)
    override def scalacPluginMvnDeps = Seq(deps.chiselPlugin)
}

trait CommonNS extends SbtModule with CommonModule with HasChisel

object DifftestLib extends CommonNS {
    override def moduleDir = pwd / "difftest"
    override def scalacOptions = Seq(
        "-Ymacro-annotations",
        "-feature",
        "-language:reflectiveCalls"
    )
}

object HardFloatLib extends CommonNS {
    override def moduleDir = pwd / "third_party" / "berkeley-hardfloat"
    override def scalacOptions = Seq("-language:reflectiveCalls", "-deprecation", "-feature")
}

object `IonSoC` extends CommonNS {
    override def moduleDir = pwd

    override def scalacOptions = Seq(
        "-language:reflectiveCalls",
        "-deprecation",
        "-feature",
        "-Xcheckinit",
        "-Ymacro-annotations"
    )

    override def moduleDeps = super.moduleDeps ++ Seq(HardFloatLib)

    object test extends SbtTests with TestModule.ScalaTest {
        // GSIM-only emitters are kept beside their independent native drivers.
        def gsimFixtureSources = Task.Sources(
            pwd / "simulator/gsim/fixtures/AiaRetiringCoreGsim.scala",
            pwd / "simulator/gsim/fixtures/AiaTranslatedCoreGsim.scala",
            pwd / "simulator/gsim/fixtures/HypervisorPlatformGsim.scala",
            pwd / "simulator/gsim/fixtures/HypervisorPlatformShapes.scala"
        )
        override def sources = Task {
            super.sources() ++ gsimFixtureSources()
        }
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object guestCounters extends SbtTests with TestModule.ScalaTest {
        // Focused test compilation; SbtTests still depends on the full IonSoC module.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/GuestCountersGsim.scala",
            pwd / "src/test/scala/ooo/GuestCountersConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuestAtomicsConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object dualFsPreparation extends SbtTests with TestModule.ScalaTest {
        // State components only; full production dependencies and H+FP guards remain.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/DualFsPreparationGsim.scala",
            pwd / "src/test/scala/ooo/FloatingPointStateGsim.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuestCountersConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuestAtomicsConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object guardedGuestFpFma extends SbtTests with TestModule.ScalaTest {
        // New exact fused variant; retain all three earlier exact-profile checks.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/GuardedGuestFpFmaGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpFmaConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpMultiplyGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpMultiplyConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpArithmeticGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpArithmeticConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpCoreGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpCoreConfigSpec.scala",
            pwd / "src/test/scala/ooo/FloatingPointStateGsim.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object guardedGuestFpMultiply extends SbtTests with TestModule.ScalaTest {
        // New exact multiplication variant; retain both previous exact-profile checks.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/GuardedGuestFpMultiplyGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpMultiplyConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpArithmeticGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpArithmeticConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpCoreGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpCoreConfigSpec.scala",
            pwd / "src/test/scala/ooo/FloatingPointStateGsim.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object guardedGuestFpArithmetic extends SbtTests with TestModule.ScalaTest {
        // New exact arithmetic variant; include unchanged moves-memory rejection checks.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/GuardedGuestFpArithmeticGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpArithmeticConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpCoreGsim.scala",
            pwd / "src/test/scala/ooo/GuardedGuestFpCoreConfigSpec.scala",
            pwd / "src/test/scala/ooo/FloatingPointStateGsim.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
