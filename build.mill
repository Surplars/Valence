            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object protectedFpRetirement extends SbtTests with TestModule.ScalaTest {
        // Test-only consumer composition; retain the complete production/HardFloat dependencies.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/ProtectedFpRetirementGsim.scala",
            pwd / "src/test/scala/ooo/ProtectedFpRetirementConfigSpec.scala",
            pwd / "src/test/scala/ooo/FloatingPointStateGsim.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object fpGuestMemoryPreparation extends SbtTests with TestModule.ScalaTest {
        // Real nested memory components, not an enabled H+FP core. Keep the full
        // production/HardFloat dependency set and compile only affected fixtures.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/FpGuestMemoryGsim.scala",
            pwd / "src/test/scala/ooo/FpGuestResponseBufferGsim.scala",
            pwd / "src/test/scala/ooo/FpGuestMemoryConfigSpec.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuestCountersConfigSpec.scala",
            pwd / "src/test/scala/ooo/GuestAtomicsConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object memoryDomainSelector extends SbtTests with TestModule.ScalaTest {
        // Three-domain component preparation only. SbtTests keeps every
        // production and HardFloat source; only affected test sources are narrow.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/MemoryDomainSelectorGsim.scala",
            pwd / "src/test/scala/ooo/MemoryDomainSelectorConfigSpec.scala",
            pwd / "src/test/scala/ooo/FpGuestMemoryConfigSpec.scala",
            pwd / "src/test/scala/ooo/DualFsPreparationConfigSpec.scala"
        )
        override def mvnDeps = super.mvnDeps() ++ Seq(deps.scalatest)
    }

    object systemOwnerBoundaries extends SbtTests with TestModule.ScalaTest {
        // Accepted-event component probes only. Keep full production/HardFloat
        // dependencies and the prior owner/selector guard checks unchanged.
        override def sources = Task.Sources(
            pwd / "src/test/scala/ooo/SystemOwnerBoundariesGsim.scala",
            pwd / "src/test/scala/ooo/SystemOwnerBoundariesConfigSpec.scala",
            pwd / "src/test/scala/ooo/MemoryDomainSelectorConfigSpec.scala"
