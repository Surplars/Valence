#!/bin/sh
set -eu
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
log() {
    read -r uptime unused < /proc/uptime
    printf '[%s] valence-platform: %s\n' "$uptime" "$*"
}
# Read driver results only. Never issue a software recovery write.
check_boot_control() {
    attribute=$1
    domain=$2
    allow_skip=$3
    control_count=0
    last_result=unknown
    confirmed=unknown
    target=unknown
    attempted=unknown
    boot_outcome=unknown
    for control_path in /sys/bus/platform/devices/*/"$attribute"; do
        [ -r "$control_path" ] || continue
        control_count=$((control_count + 1))
        control=$(cat "$control_path")
        log "$domain boot control: $control"
        set -f
        for field in $control; do
            case "$field" in
                last_result=*) last_result=${field#*=} ;;
                last_confirmed_hz=*) confirmed=${field#*=} ;;
                boot_target_hz=*) target=${field#*=} ;;
                attempted=*) attempted=${field#*=} ;;
            esac
        done
        set +f
    done
    if [ "$control_count" != 1 ] || [ "$target" != 125000000 ] || ! printf '%s\n' "$last_result" | grep -Eq '^-?[0-9]+$'; then
        log "$domain control result missing/ambiguous; stop dependent devices"
        exit 1
    fi
    if [ "$last_result" = 0 ] && [ "$confirmed" = "$target" ] &&
       { [ "$confirmed" = 50000000 ] || [ "$confirmed" = 125000000 ]; }; then
        log "$domain boot target confirmed: $confirmed Hz"
        boot_outcome=target
    elif [ "$confirmed" = 50000000 ] &&
         { [ "$last_result" != 0 ] || { [ "$allow_skip" = 1 ] && [ "$attempted" = 0 ]; }; }; then
        log "$domain target not reached; hardware confirmed 50 MHz, continue without retry"
        boot_outcome=fallback50
    else
        log "$domain rate unknown or target not confirmed; stop dependent devices, no retry"
        exit 1
    fi
}
trap 'log "Initialization failed; SBI serial recovery remains available"' 0
log 'CommonMachinePlatform Debian startup; capabilities come from this DT'
if [ -r /etc/valence/build-time ]; then
    date -u -s "$(cat /etc/valence/build-time)" >/dev/null
    log 'Wall clock seeded from image build time; no RTC'
fi
modprobe valence_soc
monitor=0
control_requested=0
pair_requested=0
for node in /sys/firmware/devicetree/base/soc/*; do
    [ -r "$node/compatible" ] || continue
    if tr '\000' '\n' < "$node/compatible" | grep -Eq '^openion,(valence-clock-monitor-v1|valence-a1-runtime-clock-monitor-v2)$'; then
        status=okay
        [ ! -r "$node/status" ] || status=$(tr -d '\000' < "$node/status")
        if [ "$status" = okay ]; then
            monitor=1
            if tr '\000' '\n' < "$node/compatible" | grep -qx 'openion,valence-a1-runtime-clock-monitor-v2'; then
                if ! tr '\000' '\n' < /sys/firmware/devicetree/base/compatible | grep -qx 'openion,valence-a1-runtime-v2'; then
                    log 'Experimental A1 hardware capability missing; stop before monitor probe'
                    exit 1
                fi
                for property in cpu-rate-control cpu-clock-observer-only cpu-boot-hz fabric-boot-hz i1-boot-pair-125; do
                    if [ -e "$node/openion,$property" ]; then
                        log 'Experimental A1 is read-only boot50; rejecting write policy'
                        exit 1
                    fi
                done
            fi
            [ ! -e "$node/openion,cpu-rate-control" ] || control_requested=1
            [ ! -e "$node/openion,i1-boot-pair-125" ] || pair_requested=1
        fi
    fi
done
if [ "$pair_requested" = 1 ] && [ "$control_requested" != 1 ]; then
    log 'Invalid paired boot policy without CPU control; stop dependent devices'
    exit 1
fi
if [ "$monitor" = 1 ]; then
    modprobe valence_clockmon
    if [ "$control_requested" = 1 ]; then
        check_boot_control cpu_control CPU 0
        cpu_boot_outcome=$boot_outcome
        if [ "$pair_requested" = 1 ]; then
            allow_fabric_skip=0
            [ "$cpu_boot_outcome" != fallback50 ] || allow_fabric_skip=1
            check_boot_control fabric_boot_control FABRIC "$allow_fabric_skip"
            if [ "$cpu_boot_outcome" = fallback50 ] && [ "$boot_outcome" != fallback50 ]; then
                log 'Contradictory CPU50/fabric125 pair; stop dependent devices'
                exit 1
            fi
        fi
    fi
else
    log 'SKIP_UNSUPPORTED: no enabled runtime clock/telemetry window'
fi
modprobe valence_cmu
modprobe valence_aia
ready=0
for status in /sys/bus/platform/devices/*/irqchip_status; do
    if [ -r "$status" ] && grep -q 'ready=1 faulted=0' "$status"; then ready=1; fi
done
if [ "$ready" != 1 ]; then
    log 'IRQ selftest failed; refusing both DMA consumers'
    exit 1
fi
modprobe valence_dma
modprobe valence_gmac
log 'Matched platform drivers ready; no script-level MMIO writes'
trap - 0
