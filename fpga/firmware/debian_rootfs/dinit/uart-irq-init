# Sourced by /init after API filesystems are mounted, before Dinit starts.
# V4: proc/status observations are diagnostics, never a PID 1 boot gate.
# The actual IRQ controller and upstream 8250 remain enabled and unchanged.
uart_proc=/proc/tty/driver/serial_8250
uart_log() {
    printf '<4>valence-uart-v4: %s\n' "$*" > /dev/kmsg || :
    printf '%s\n' "$*" >> /run/valence/uart-startup.log || :
    return 0
}
uart_warn() {
    uart_log "$*; continuing to Dinit; UART IRQ traffic unverified"
    printf '%s\n' "$*" >> /run/valence/uart-warning || :
    return 0
}
uart_log 'readiness self-check disabled; native ttyS0 handoff follows'
# Required to make the existing modular IRQ domain available. A failure is
# reported here; the separate platform service still protects DMA consumers.
if ! modprobe valence_aia; then
    uart_warn 'IRQ controller module load failed'
fi
# Record cheap filesystem observations without parsing a proc line or waiting
# for its formatting to satisfy a predicate. Detailed snapshots are available
# through boot-diagnose after login.
if [ -r "$uart_proc" ]; then
    uart_log "proc visible: $uart_proc"
else
    uart_log "proc unavailable: $uart_proc"
fi
if [ -c /dev/ttyS0 ]; then
    uart_log 'ttyS0 character node present'
    # Coreutils stty opens the device non-blocking. Bound this setup helper;
    # agetty also sets the baud and owns normal terminal input after Dinit starts.
    if ! timeout 2 stty -F /dev/ttyS0 460800 cs8 -parenb -cstopb -crtscts clocal cread; then
        uart_warn 'ttyS0 termios setup failed or timed out'
    fi
    # command exec makes redirection errors recoverable in Debian dash. Do not
    # replace this with bare exec: its redirection failure exits PID 1.
    if command exec < /dev/ttyS0 > /dev/ttyS0 2>&1; then
        uart_log 'ttyS0 descriptors opened; continuing to Dinit; UART IRQ traffic unverified'
    else
        uart_warn 'ttyS0 descriptor reopen failed; retaining inherited console'
    fi
else
    uart_warn 'ttyS0 character node absent; getty will attempt its own open'
fi
# Never sleep forever, return failure to /init, or suppress Dinit on an
# observation mismatch. Opening a descriptor does not prove IRQ RX/TX works.
true
