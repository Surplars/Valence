[
  "-std=c++20",
  "-O1",
  "-g",
  "-fsanitize=address,undefined",
  "-fno-sanitize-recover=all",
  "-DDDR_MODEL=1",
  "-DDDR_MULTI_ID_MODEL=1",
  "-DDDR_BENCHMARK_MODEL=1",
  "-DBOARD_CPU_HZ=100000000",
  "-DBOARD_UART_BAUD=460800",
  "-DUART_DIVISOR=1",
  "-DBOARD_DDR_BYTES=2147483648ULL",
  "-DDDR_READ_CREDITS=8",
  "-DDDR_READ_LATENCY=32",
  "-DDDR_READ_BEAT_GAP=1",
  "-DBOARD_CYCLE_LIMIT=2600000ULL",
  "-DBOARD_EXPECTED_LSU_ENTRIES=4",
  "-DREAD_PREFETCH_DIRTY_RETRY=1",
  "-DREAD_PREFETCH_DEMAND_ADOPTION=1",
  "-DREAD_PREFETCH_BEHIND_STORE=1",
  "-DDURABLE_READ_PREFETCH_CANDIDATE=1",
  "-DTAGGED_STORE_RETURNS=1",
  "-DCONCURRENT_READ_STORE_PREFETCH=1",
  "-DMEMORY_SCHEDULE_OVERLAP=1",
  "-DFUTURE_WAY_RESERVATION=1",
  "-DSTORE_PREFETCH_LRU_VICTIM=1"
]
