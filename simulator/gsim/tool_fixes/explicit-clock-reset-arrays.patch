--- a/src/cppEmitter.cpp
+++ b/src/cppEmitter.cpp
@@ -649,16 +649,36 @@
     for (Node* member : super->member) {
       Node* reg = member->type == NODE_REG_RESET ? member->getResetSrc() : member;
       if (!emitted.insert(reg).second) continue;
-      Assert(!reg->isArray(), "explicit-edge reset arrays must be split: %s", reg->name.c_str());
       valInfo* value = reg->resetTree->getRoot()->getChild(1)->compute(reg, reg->name, false);
-      if (isUIntReset) {
-        emitBodyLock(indent, "if (_gsim_edge_%s) %s = %s;\n", reg->clock->name.c_str(),
-                     reg->getDst()->name.c_str(), value->valStr.c_str());
-      } else {
-        emitBodyLock(indent, "_gsim_reset_changed |= (%s != %s);\n", reg->name.c_str(), value->valStr.c_str());
-        emitBodyLock(indent, "%s = %s;\n", reg->name.c_str(), value->valStr.c_str());
-        if (reg->getDst()->status == VALID_NODE)
-          emitBodyLock(indent, "%s = %s;\n", reg->getDst()->name.c_str(), value->valStr.c_str());
+      // Preserve aggregate register storage, but reset every logical element.
+      // Dynamic-index arrays cannot always use the scalar split optimization.
+      const size_t entries = reg->isArray() ? reg->arrayEntryNum() : 1;
+      for (size_t index = 0; index < entries; ++index) {
+        std::string suffix;
+        size_t remaining = index;
+        for (size_t dim = reg->dimension.size(); dim > 0; --dim) {
+          const size_t extent = reg->dimension[dim - 1];
+          suffix = "[" + std::to_string(remaining % extent) + "]" + suffix;
+          remaining /= extent;
+        }
+        std::string resetValue = value->valStr;
+        if (reg->isArray()) {
+          valInfo* element = value->getMemberInfo(index);
+          if (element) resetValue = element->valStr;
+          else if (value->isArrayRef()) resetValue += suffix;
+          else Assert(value->sameConstant, "unsupported reset array expression: %s", reg->name.c_str());
+        }
+        const std::string current = reg->name + suffix;
+        const std::string next = reg->getDst()->name + suffix;
+        if (isUIntReset) {
+          emitBodyLock(indent, "if (_gsim_edge_%s) %s = %s;\n", reg->clock->name.c_str(),
+                       next.c_str(), resetValue.c_str());
+        } else {
+          emitBodyLock(indent, "_gsim_reset_changed |= (%s != %s);\n", current.c_str(), resetValue.c_str());
+          emitBodyLock(indent, "%s = %s;\n", current.c_str(), resetValue.c_str());
+          if (reg->getDst()->status == VALID_NODE)
+            emitBodyLock(indent, "%s = %s;\n", next.c_str(), resetValue.c_str());
+        }
       }
     }
     emitBodyLock(--indent, "}\n");
