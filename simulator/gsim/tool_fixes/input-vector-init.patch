+// Public Vec ABI matches the padded physical backing array. Logical lanes alone
+// participate in setter comparison/copy; padding never drives activation.
+static std::string interfaceDimensions(Node* node) {
+  std::string dims;
+  for (int dim : node->dimension) dims += format("[%d]", upperPower2(dim));
+  return dims;
+}
+
+static std::string constantArrayInitializer(Node* node, size_t dimension) {
+  if (dimension == node->dimension.size()) {
+    // Signed constants are represented in unsigned physical storage. An explicit
+    // conversion preserves the bits without C++ list-initialization narrowing.
+    return format("static_cast<%s>(%s)", widthUType(node->width).c_str(), node->computeInfo->valStr.c_str());
+  }
+  std::string value = "{";
+  for (int i = 0; i < node->dimension[dimension]; ++i) {
+    if (i) value += ", ";
+    value += constantArrayInitializer(node, dimension + 1);
+  }
+  return value + "}"; // omitted padding lanes are value-initialized to zero
+}
